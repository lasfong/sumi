{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumi.local/schemas/drawing-document-v1.schema.json",
  "title": "SumiDrawingDocumentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "sessionId", "symbol", "drawings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "sessionId": { "type": "integer", "minimum": 1 },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
    "drawings": {
      "type": "array",
      "items": { "$ref": "#/$defs/drawing" }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "price"],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))$"
        },
        "price": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineColor", "lineWidth", "lineStyle"],
      "properties": {
        "lineColor": { "type": "string", "minLength": 1 },
        "lineWidth": { "type": "integer", "minimum": 1, "maximum": 8 },
        "lineStyle": { "enum": ["solid", "dashed", "dotted"] },
        "fillColor": { "type": "string", "minLength": 1 },
        "fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "textColor": { "type": "string", "minLength": 1 },
        "fontSize": { "type": "integer", "minimum": 8, "maximum": 72 }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["horizontal", "trendline", "ray", "rectangle"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "levels", "direction"],
          "properties": {
            "kind": { "const": "fibonacci-retracement" },
            "levels": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "prefixItems": [
                { "$ref": "#/$defs/fibonacciLevel0" },
                { "$ref": "#/$defs/fibonacciLevel0236" },
                { "$ref": "#/$defs/fibonacciLevel0382" },
                { "$ref": "#/$defs/fibonacciLevel05" },
                { "$ref": "#/$defs/fibonacciLevel0618" },
                { "$ref": "#/$defs/fibonacciLevel0786" },
                { "$ref": "#/$defs/fibonacciLevel1" }
              ],
              "items": false
            },
            "direction": { "enum": ["start-to-end", "end-to-start"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]*$" }
          }
        }
      ]
    },
    "drawing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "paneId", "order", "visible", "locked", "anchors", "style", "geometry"],
      "allOf": [
        {
          "if": { "properties": { "tool": { "const": "horizontal" } } },
          "then": {
            "properties": {
              "anchors": { "type": "array", "minItems": 1, "maxItems": 1 },
              "geometry": { "type": "object", "properties": { "kind": { "const": "horizontal" } } }
            }
          }
        },
        {
          "if": { "properties": { "tool": { "const": "trendline" } } },
          "then": {
            "properties": {
              "anchors": { "type": "array", "minItems": 2, "maxItems": 2 },
              "geometry": { "type": "object", "properties": { "kind": { "const": "trendline" } } }
            }
          }
        },
        {
          "if": { "properties": { "tool": { "const": "ray" } } },
          "then": {
            "properties": {
              "anchors": { "type": "array", "minItems": 2, "maxItems": 2 },
              "geometry": { "type": "object", "properties": { "kind": { "const": "ray" } } }
            }
          }
        },
        {
          "if": { "properties": { "tool": { "const": "rectangle" } } },
          "then": {
            "properties": {
              "anchors": { "type": "array", "minItems": 2, "maxItems": 2 },
              "geometry": { "type": "object", "properties": { "kind": { "const": "rectangle" } } }
            }
          }
        },
        {
          "if": { "properties": { "tool": { "const": "fibonacci-retracement" } } },
          "then": {
            "properties": {
              "anchors": { "type": "array", "minItems": 2, "maxItems": 2 },
              "geometry": { "type": "object", "properties": { "kind": { "const": "fibonacci-retracement" } } }
            }
          }
        },
        {
          "if": { "properties": { "tool": { "const": "text" } } },
          "then": {
            "properties": {
              "anchors": { "type": "array", "minItems": 1, "maxItems": 1 },
              "geometry": { "type": "object", "properties": { "kind": { "const": "text" } } }
            }
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "tool": { "enum": ["horizontal", "trendline", "ray", "rectangle", "fibonacci-retracement", "text"] },
        "paneId": { "const": "price" },
        "order": { "type": "integer", "minimum": 0 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "anchors": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/anchor" } },
        "style": { "$ref": "#/$defs/style" },
        "geometry": { "$ref": "#/$defs/geometry" }
      }
    },
    "fibonacciLevel0": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 0 } } },
    "fibonacciLevel0236": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 0.236 } } },
    "fibonacciLevel0382": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 0.382 } } },
    "fibonacciLevel05": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 0.5 } } },
    "fibonacciLevel0618": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 0.618 } } },
    "fibonacciLevel0786": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 0.786 } } },
    "fibonacciLevel1": { "$ref": "#/$defs/fibonacciLevelTemplate", "type": "object", "properties": { "ratio": { "const": 1 } } },
    "fibonacciLevelTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "visible"],
      "properties": {
        "ratio": { "type": "number" },
        "visible": { "type": "boolean" },
        "color": { "type": "string", "minLength": 1 }
      }
    }
  }
}
